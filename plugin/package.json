  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@preact/preset-vite": "2.10.2",
    "@types/crypto-js": "4.2.2",
    "@types/node": "22.15.30",
    "fake-indexeddb": "6.0.1",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
